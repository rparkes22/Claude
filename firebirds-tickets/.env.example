# Required: password for the /admin panel
ADMIN_PASSWORD=change-me

# Optional: secret used to sign the admin session cookie.
# If unset, a random secret is generated at startup (admins are logged out on restart).
SESSION_SECRET=

# Optional: where the SQLite database lives (default: ./data/firebirds.db)
DB_PATH=./data/firebirds.db

# Optional: port to listen on (default: 3000)
PORT=3000

# Optional: set to "1" when running behind HTTPS so the admin cookie is marked Secure
SECURE_COOKIES=0

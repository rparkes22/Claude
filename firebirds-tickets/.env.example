# Required: password for the /admin panel
ADMIN_PASSWORD=change-me

# Postgres connection string (Supabase, Neon, etc). When unset, an embedded PGlite
# database is used instead: in-memory by default, or on disk if PGLITE_DIR is set.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Optional: secret used to sign the admin session cookie.
# If unset, a random secret is generated at startup (admins are logged out on restart).
SESSION_SECRET=

# Optional: port to listen on (default: 3000)
PORT=3000

# Optional: set to "1" when running behind HTTPS so the admin cookie is marked Secure (automatic on Vercel)
SECURE_COOKIES=0
